#!/usr/bin/env bash
# commit-msg hook — shea's message policy.
#
# The workspace-wide rule (see ~/workspaces/CLAUDE.md, "expunge Claude
# sessions") bans agent session URLs from commit messages: on a PUBLIC repo a
# session link is cloned, forked and cached forever, and it is agent plumbing
# rather than repository provenance.
#
# shea takes the documented exception, by the repo owner's decision
# (2026-09-05): session trailers ARE allowed here. shea is private and
# experimental, and its whole point is tracing how agentic work was produced —
# the session that produced a commit is provenance in this repo, not noise.
# If shea ever goes public, revisit this and scrub history first.
#
# The hook stays as the place that policy lives, and enforces the one rule
# that has no exception: a message must have a non-empty subject line.
#
# PIPELINE PARITY: message hygiene only — not a CI-mirror step. The pre-push
# hook (.githooks/pre-push) is the lint/test gate; this is orthogonal.
set -euo pipefail

msg_file="$1"

# First non-comment, non-blank line is the subject.
subject=$(grep -v '^\s*#' "$msg_file" | grep -m1 -v '^\s*$' || true)
if [ -z "$subject" ]; then
    echo "✗ commit blocked: empty commit message." >&2
    exit 1
fi

exit 0
